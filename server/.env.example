SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-32chars
DATABASE_URL=sqlite:///myhobbyboard.db
FLASK_APP=run.py
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=1
# AI Planning Assistant (Google Gemini is recommended for free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional Anthropic API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Allowed CORS origins (comma-separated, e.g. https://myhobbyboard.com,http://localhost:5173)
CORS_ORIGINS=
# Media uploads: when set, uploaded photos/videos persist in Cloudinary instead
# of local disk (required for hosts with ephemeral storage, e.g. Render).
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
